{% extends 'base.html.twig' %}

{% block title %}Hello LinkController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Résultats pour {{ Item_type }}! ✅</h1>
    {% for link in linksList %}
        <article>
            <header0>{{link.name}}</header>
            <img href="{{link.icon}}" alt="illustration du lien">
            {{link.description}}

            Catégories : 
            {% for cat in link.categories %}
            {{cat.name}}
            {% endfor %}
            <footer>Auteur : {{link.account.firstname}} {{link.account.lastname}}Date d'ajout : {{DateTimeImmutable::createFromFormat('Y-m-d',link.createdAt)}}
            Lien : {{link.url}}</footer>
        </article>
    {% endfor %}
</div>
{% endblock %}
